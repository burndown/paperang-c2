# /etc/default/paperang-c2 -- read by the paperang-c2 and paperang-ipp services (written by install.sh)
# Bluetooth address of the printer (find it with: python3 -m paperang_c2 scan)
PAPERANG_ADDR=AA:BB:CC:DD:EE:FF
# Width of the paper actually loaded, in mm. A "4 inch" roll is 101.6 mm; the firmware may report more.
PAPERANG_PAPER_WIDTH_MM=101.6
# AirPrint: crop the white margins of every page and scale it to the paper width (0 = off)
PAPERANG_CROP=1
